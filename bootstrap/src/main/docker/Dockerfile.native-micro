####
# Native image for app-food.
# quarkus-awt (via quarkus-pdfbox) may emit shared libraries next to the runner.
#
# Build:
#   ./mvnw package -Dnative -Dquarkus.native.container-build=true -pl bootstrap -am
# Image:
#   docker build -f bootstrap/src/main/docker/Dockerfile.native-micro -t neuland/app-food bootstrap
###
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

# Copy the whole native build output, then keep only the runner (+ optional .so libs).
COPY --chown=1001:root target/ /tmp/native-build/
RUN set -e; \
    cp /tmp/native-build/*-runner /work/application; \
    chmod 0755 /work/application; \
    find /tmp/native-build -maxdepth 1 \( -name '*.so' -o -name '*.so.*' \) -exec cp -t /work {} + || true; \
    rm -rf /tmp/native-build

ENV LD_LIBRARY_PATH=/work

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
