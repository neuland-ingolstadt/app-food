<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>app.neuland</groupId>
    <artifactId>app-food-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.40.1.2</quarkus.platform.version>
        <maven.compiler.release>25</maven.compiler.release>
        <surefire-plugin.version>3.6.1</surefire-plugin.version>
        <jacoco.version>0.8.16</jacoco.version>
        <backend-food-api.version>1.2.3</backend-food-api.version>
        <hash4j.version>0.22.0</hash4j.version>
        <quarkus-pdfbox.version>1.2.3</quarkus-pdfbox.version>
        <sonar.organization>neuland-ingolstadt</sonar.organization>
        <sonar.projectKey>neuland-ingolstadt_app-food</sonar.projectKey>
        <sonar.projectName>app-food</sonar.projectName>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.aggregateXmlReportPaths>${maven.multiModuleProjectDirectory}/target/coverage/jacoco.xml</sonar.coverage.jacoco.aggregateXmlReportPaths>
        <jacoco.destFile>${maven.multiModuleProjectDirectory}/target/jacoco.exec</jacoco.destFile>
    </properties>
    
    <repositories>
        <repository>
            <id>github-neuland-contracts</id>
            <url>https://maven.pkg.github.com/neuland-ingolstadt/app-backend-contracts</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>app.neuland</groupId>
                <artifactId>backend-food-api</artifactId>
                <version>${backend-food-api.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dynatrace.hash4j</groupId>
                <artifactId>hash4j</artifactId>
                <version>${hash4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.pdfbox</groupId>
                <artifactId>quarkus-pdfbox</artifactId>
                <version>${quarkus-pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.82</version>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <modules>
        <module>domain</module>
        <module>application</module>
        <module>adapters-outbound-persistence</module>
        <module>adapters-outbound-scraping</module>
        <module>adapters-inbound-rest</module>
        <module>bootstrap</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                            <configuration>
                                <destFile>${jacoco.destFile}</destFile>
                                <append>true</append>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
